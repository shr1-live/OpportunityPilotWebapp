# Copy to .env.local (git-ignored). Only public values belong here: everything
# prefixed VITE_ is compiled into the browser bundle.

# API base URL (no trailing slash). Defaults to http://localhost:5051.
VITE_API_BASE_URL=http://localhost:5051

# Supabase Auth (publishable/anon key only — never the service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development only: sign in with any name, sent to the API as X-Dev-User.
# Requires the API running in Development with Auth:DevBypass=true. Ignored in production builds.
VITE_DEV_AUTH=true
